# Copy this file to .env before changing these values.
# The API has no authentication; keep the host binding local unless protected.
SOMARIS_HOST_IP=127.0.0.1
SOMARIS_HOST_PORT=8080

# Enable both built-in simulated blinds.
SOMARIS_SIMULATOR=true
# Demo mode is opt-in. When enabled, Somaris disables Bluetooth and seeds four
# visitor-isolated simulated blinds; use it only for a simulator demonstration.
SOMARIS_DEMO_MODE=false
# Override when the container listens on a different address or port.
# SOMARIS_HEALTH_URL=http://127.0.0.1:8080/api/v1/health
# Linux host system-bus directory; see README for simulator-only hosts.
# SOMARIS_DBUS_DIR=/run/dbus
SOMARIS_ALLOWED_ORIGINS=
RUST_LOG=info

# Optional path for the telemetry-sample journal; defaults beside state.json.
# Setting it also enables the telemetry history API.
# SOMARIS_HISTORY_PATH=/data/history.json

# Command queue and Bluetooth adapter defaults.
SOMARIS_COMMAND_MAX_OUTSTANDING=1000
SOMARIS_COMMAND_MAX_QUEUED_PER_DEVICE=32
SOMARIS_ADAPTER_CONCURRENCY=1
SOMARIS_ADAPTER_SCAN_WINDOW_MS=1000
SOMARIS_COMMAND_QUEUE_WAIT_TIMEOUT_SECONDS=120
