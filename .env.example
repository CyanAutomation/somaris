# Optional: Compose defaults to publishing only on localhost at port 8080.
SOMARIS_HOST_IP=127.0.0.1
SOMARIS_HOST_PORT=8080

# Linux host system-bus directory. The default is /run/dbus.
# SOMARIS_DBUS_DIR=/run/dbus

# Advanced SOMARIS_* overrides placed in .env are passed into the container.
# Most service settings will be manageable from the Somaris Settings page.
